# Copy to .env (or run `node scripts/init-env.mjs`, which also generates the random secrets).
# Never commit .env. Items marked (later) are for phases not built yet.

# --- Claude API ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
DRAFTING_MODEL=claude-sonnet-5-5

# --- Supabase -----------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Admin connection, used only by setup scripts (schema, roles, cleanup). Connect button ->
# "Session pooler" URI, with your database password filled in. Never given to a running service.
SUPABASE_DB_URL=
# n8n's least-privilege role n8n_writer (seed/sql/003_roles.sql). Written by scripts/db-setup.mjs;
# scripts/n8n-credentials.mjs builds n8n's Postgres credential from it.
N8N_DB_URL=

# --- MCP server ---------------------------------------------------------------
# json = read seed/data/*.json; postgres = read Supabase through DATABASE_URL
DATA_SOURCE=json
# READ-ONLY role connection (seed/sql/003_roles.sql), set up by the database step, e.g.
# postgres://mcp_readonly.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# require | no-verify | disable
DATABASE_SSL=require
# Generated by init-env. n8n's MCP Client node sends it as a Bearer token.
MCP_AUTH_TOKEN=
# Optional: pin "now" for demos and evaluation runs, e.g. 2026-11-09T10:00:00Z
FIXED_NOW=
LOG_LEVEL=info

# --- n8n and ngrok ------------------------------------------------------------
# ngrok dashboard -> Getting Started -> Your Authtoken
NGROK_AUTHTOKEN=
# ngrok dashboard -> Domains: your free dev domain WITHOUT https://, e.g. something.ngrok-free.app
NGROK_DOMAIN=
# On the server (compose.server.yml, docs/deploy.md) instead of ngrok: the public host Caddy serves,
# e.g. enquiries.raynors.dev. Scripts use it before NGROK_DOMAIN when it's set.
PUBLIC_HOST=
# Generated by init-env. Encrypts the credentials n8n stores: never change it after first start, and back it up.
N8N_ENCRYPTION_KEY=
# Generated by init-env. Header key for the evaluation webhook (Test intake workflow).
TEST_WEBHOOK_KEY=
# n8n (http://localhost:5678) -> Settings -> n8n API -> Create an API key. Lets the setup scripts create
# credentials and import workflows.
N8N_API_KEY=

# --- Slack approval app (infra/slack-app-manifest.yml) -------------------------
# OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=
# Channel names without '#'. The bot must be invited to both (/invite @Harbourline Enquiries).
SLACK_APPROVAL_CHANNEL=enquiries
SLACK_ALERTS_CHANNEL=alerts
# Filled in by: node scripts/slack-setup.mjs
SLACK_APPROVAL_CHANNEL_ID=
SLACK_ALERTS_CHANNEL_ID=

# --- Google -------------------------------------------------------------------
# Google Auth platform -> Clients -> your Web client (n8n uses it for Gmail and Calendar)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# seed = calendar template in seed/data/calendar.json; google = the real demo calendar (read-only)
CALENDAR_SOURCE=seed
# Google Calendar -> the "Harbourline Bookings" calendar's settings -> Integrate calendar -> Calendar ID
GOOGLE_CALENDAR_ID=
# Full path to the service account's JSON key, kept OUTSIDE the repo,
# e.g. C:\Users\you\.secrets\harbourline-calendar-sa.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
