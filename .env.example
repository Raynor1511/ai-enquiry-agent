# Copy to .env and fill in. Never commit .env.
# Items marked (later) are for phases not built yet; leave them blank until then.

# --- Claude API (later) -------------------------------------------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
DRAFTING_MODEL=claude-sonnet-5-5

# --- MCP server ---------------------------------------------------------------
# json = read seed/data/*.json (local dev); postgres = read the database
DATA_SOURCE=json
# Connection string for the READ-ONLY role (seed/sql/003_roles.sql), not the admin user.
# Supabase pooler example: postgres://mcp_readonly.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# require | no-verify | disable
DATABASE_SSL=require
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=3333
# Required for HTTP on a non-local address. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
# Optional: pin "now" for demos and evaluation runs, e.g. 2026-11-09T10:00:00Z
FIXED_NOW=
LOG_LEVEL=info

# --- Supabase (later: used by n8n for writes) --------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Slack approval app (later) -----------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=
SLACK_ALERTS_CHANNEL=

# --- Google (later) -----------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
# Path to the service-account JSON key (kept outside the repo)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- n8n (later) --------------------------------------------------------------
N8N_HOST=
WEBHOOK_URL=
