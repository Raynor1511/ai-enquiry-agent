{
  "name": "harbourline-mcp-server",
  "version": "0.1.0",
  "description": "Read-only MCP server exposing a small business's customers, services, policies, service area and calendar availability as tools for an AI enquiry agent.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "harbourline-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "node scripts/test-pg.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
